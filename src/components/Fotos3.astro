<!-- ═══════════════════════════════════════════════════════════ --><!-- 📸 SECCIÓN: GALERÍA DE FOTOS                                --><!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-2 sm:py-20 md:py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- CONTENEDOR DE FOTO ÚNICA -->
        <div class="relative w-full max-w-md mx-auto">
            <div
                id="fotos3-a"
                class="relative w-full aspect-[4/5] rounded-lg shadow-lg overflow-hidden cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-xl"
                data-aos="fade-up"
                data-aos-duration="800"
                data-aos-delay="100"
            >
                <img
                    src="/imagenes/foto5.jpeg"
                    alt="Foto"
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🖼️ MODAL CON FONDO BLANCO ELEGANTE                         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<div
    id="modalFotos3"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="opacity: 0; transition: opacity 0.3s ease; backdrop-filter: blur(10px);"
>
    <!-- FONDO BLANCO CON TOQUE PLOMO -->
    <div
        class="absolute inset-0 bg-gradient-to-br from-[#F6F1E7] via-[#EFE7D8] to-[#F6F1E7] opacity-98"
    >
    </div>

    <!-- CONTENIDO DEL MODAL -->
    <div class="relative max-w-5xl w-full z-10">
        <!-- BOTÓN CERRAR -->
        <button
            id="btnCerrarFotos3"
            class="absolute -top-12 right-0 text-[#6B5344] hover:text-[#4B3628] transition-all duration-200 text-4xl font-bold hover:scale-110 hover:rotate-90 drop-shadow-lg"
            aria-label="Cerrar modal"
        >
            ✕
        </button>
        <!-- IMAGEN PRINCIPAL NÍTIDA -->
        <img
            id="modalImageFotos3"
            src=""
            alt="Foto ampliada"
            class="w-full h-auto max-h-[90vh] object-contain rounded-lg shadow-xl"
        />
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📦 LIBRERÍA AOS PARA ANIMACIONES                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
/>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"
></script>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📜 JAVASCRIPT PARA EL MODAL Y ANIMACIONES                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
<script is:inline>
    // Inicializar AOS
    AOS.init({
        duration: 800,
        easing: "ease-in-out",
        once: true,
        mirror: false,
        offset: 100,
    });

    // Esperar a que el DOM esté listo
    document.addEventListener("DOMContentLoaded", function () {
        const modal = document.getElementById("modalFotos3");
        const modalImage = document.getElementById("modalImageFotos3");
        const foto1 = document.getElementById("fotos3-a");
        const btnCerrar = document.getElementById("btnCerrarFotos3");

        // Función para abrir modal
        function abrirModal(imageSrc) {
            modalImage.src = imageSrc;
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";

            setTimeout(() => {
                modal.style.opacity = "1";
            }, 10);
        }

        // Función para cerrar modal
        function cerrarModal() {
            modal.style.opacity = "0";
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                document.body.style.overflow = "auto";
            }, 300);
        }

        // Click en foto
        if (foto1) {
            foto1.addEventListener("click", function () {
                abrirModal("/imagenes/foto5.jpeg");
            });
        }

        // Click en botón cerrar
        if (btnCerrar) {
            btnCerrar.addEventListener("click", function (e) {
                e.stopPropagation();
                cerrarModal();
            });
        }

        // Click en el fondo para cerrar
        if (modal) {
            modal.addEventListener("click", function (e) {
                if (e.target === modal) {
                    cerrarModal();
                }
            });
        }

        // Prevenir cierre al clickear la imagen
        if (modalImage) {
            modalImage.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Cerrar con tecla ESC
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                cerrarModal();
            }
        });
    });
</script>
