---
// Portada.astro
---

<section
    id="portada-sobre"
    class="fixed inset-0 w-full h-screen z-50 flex flex-col items-center justify-between overflow-hidden bg-white py-8 md:py-16"
>
    <!-- TEXTO SUPERIOR: "DALE CLICK" -->
    <div class="text-center z-50">
        <h1
            class="font-crimson text-2xl md:text-3xl lg:text-4xl text-[#4B3628] font-semibold tracking-[0.3em] uppercase mb-2"
        >
            DALE CLICK
        </h1>
        <p
            class="font-crimson text-lg md:text-sm text-[#4B3628] tracking-wider uppercase mb-8"
        >
            En el sobre para ver la<br /> invitación
        </p>
    </div>

    <!-- SOLAPA IZQUIERDA DEL SOBRE -->
    <div
        id="sobre-izq"
        class="absolute left-0 top-0 w-1/2 h-full z-20 overflow-hidden"
    >
        <img
            src="/imagenes/portada.png"
            alt="Portada Izquierda"
            class="absolute top-1/2 left-0 h-full w-auto object-cover"
            style="transform: translateY(-50%); object-position: left center;"
        />
    </div>

    <!-- SOLAPA DERECHA DEL SOBRE -->
    <div
        id="sobre-der"
        class="absolute right-0 top-0 w-1/2 h-full z-20 overflow-hidden"
    >
        <img
            src="/imagenes/portada.png"
            alt="Portada Derecha"
            class="absolute top-1/2 right-0 h-full w-auto object-cover"
            style="transform: translateY(-50%); object-position: right center;"
        />
    </div>

    <!-- BOTÓN CENTRAL (boton.png) -->
    <div class="relative z-50 pointer-events-auto">
        <button
            id="btn-sello"
            class="relative cursor-pointer transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
        >
            <img
                src="/imagenes/boton.png"
                alt="Sello"
                class="w-32 h-32 md:w-40 md:h-40 lg:w-48 lg:h-48"
                style="opacity: 1;"
            />
        </button>
    </div>

    <!-- TEXTO INFERIOR: "Atentamente: Pablo Misael y María Belén" -->
    <div class="text-center z-50">
        <p class="font-crimson text-2xl md:text-base text-[#4B3628] mb-2">
            Atentamente:
        </p>
        <h2
            class="font-great-vibes pb-4 text-4xl md:text-5xl lg:text-6xl text-[#6B1E2E]"
        >
            Pablo Misael <br /> & <br />María Belén
        </h2>
    </div>
</section>

<!-- Clic del sello: se engancha apenas aparece el botón, sin esperar a que
     carguen las animaciones del resto de la invitación (en celulares con señal
     regular eso tardaba varios segundos y el sello parecía no funcionar) -->
<script is:inline>
    (function () {
        var btnSello = document.getElementById("btn-sello");
        var portada = document.getElementById("portada-sobre");
        var abierto = false;

        btnSello &&
            btnSello.addEventListener("click", function () {
                if (abierto) return;
                abierto = true;

                // Crear y reproducir música automáticamente
                var audio = new Audio("/musica/melodia.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch(function (error) {
                    console.log("Error al reproducir audio:", error);
                });

                // Guardar en window para que NombresFlores pueda controlarlo
                window.audioGlobal = audio;
                window.estaReproduciendoGlobal = true;

                // Actualizar iconos inmediatamente
                setTimeout(function () {
                    var iconoPlay = document.getElementById("icono-play");
                    var iconoPause = document.getElementById("icono-pause");
                    if (iconoPlay && iconoPause) {
                        iconoPlay.classList.add("hidden");
                        iconoPause.classList.remove("hidden");
                    }
                }, 100);

                // Desvanecer la portada y quitarla
                document.body.style.overflow = "auto";
                portada.style.transition = "opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)";
                portada.style.opacity = "0";
                setTimeout(function () {
                    portada.remove(); // Eliminar completamente del DOM
                }, 800);
            });
    })();
</script>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        // Si ya abrieron el sobre antes de que cargue esto, no hay nada que animar
        if (!document.getElementById("btn-sello")) return;

        // Animación de entrada sutil del sello (SIN cambios de opacidad)
        gsap.from("#btn-sello", {
            scale: 0.8,
            duration: 1.5,
            ease: "elastic.out(1, 0.5)",
            delay: 0.5,
        });

        // Animación de respiración del sello (SIN cambios de opacidad)
        gsap.to("#btn-sello", {
            scale: 1.05,
            duration: 2.5,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
        });
    });
</script>

<style>
    body {
        overflow: hidden;
    }

    /* Asegurar que no haya líneas blancas entre las mitades */
    #sobre-izq,
    #sobre-der {
        margin: 0;
        padding: 0;
    }

    #sobre-izq img,
    #sobre-der img {
        margin: 0;
        padding: 0;
        display: block;
    }
</style>
